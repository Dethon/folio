; Folio installer.
;
; Built by scripts/package-windows.sh, which supplies:
;   VERSION   the version from Cargo.toml, e.g. 0.1.0
;   DIST      the directory holding folio.exe, pdfium.dll and the licences
;   ICON      the application icon (.ico)
;   OUTFILE   where to write the installer
;   PUBLISHER (optional) the name shown as publisher in Windows' app list
;
; Installs for the current user only, so it never asks for administrator
; rights. Everything it writes lives under the install directory and HKCU,
; and the uninstaller removes exactly that.

Unicode true
ManifestDPIAware true
RequestExecutionLevel user
SetCompressor /SOLID lzma

!ifndef VERSION
  !error "VERSION is not defined; build with scripts/package-windows.sh"
!endif

!define NAME "Folio"
!define EXE "folio.exe"
!define DESCRIPTION "A fast, minimal PDF reader"
!define SETTINGS_KEY "Software\Folio"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Folio"
!define CLASSES "Software\Classes"
; The file type Folio offers itself for. It is added to the "Open with" list
; for .pdf; whichever program currently opens PDFs keeps doing so until the
; user chooses otherwise.
!define PROGID "Folio.Document"

Name "${NAME}"
OutFile "${OUTFILE}"
InstallDir "$LOCALAPPDATA\Programs\${NAME}"
; Reinstalling or upgrading goes where the previous version went.
InstallDirRegKey HKCU "${SETTINGS_KEY}" "InstallDir"

VIProductVersion "${VERSION}.0"
VIAddVersionKey "ProductName" "${NAME}"
VIAddVersionKey "ProductVersion" "${VERSION}"
VIAddVersionKey "FileDescription" "${NAME} Setup"
VIAddVersionKey "FileVersion" "${VERSION}"
!ifdef PUBLISHER
  VIAddVersionKey "CompanyName" "${PUBLISHER}"
  VIAddVersionKey "LegalCopyright" "${PUBLISHER}"
!else
  VIAddVersionKey "LegalCopyright" ""
!endif

!include "MUI2.nsh"
!include "FileFunc.nsh"

!define MUI_ICON "${ICON}"
!define MUI_UNICON "${ICON}"
; Side panel of the first and last pages; generated by examples/make-icon.
!define MUI_WELCOMEFINISHPAGE_BITMAP "welcome.bmp"
!define MUI_ABORTWARNING
!define MUI_WELCOMEPAGE_TEXT "Setup will install ${NAME} ${VERSION} for your user account. No administrator rights are needed.$\r$\n$\r$\n${NAME} will be added to the Open with list for PDF files; your current default PDF program is not changed."
!define MUI_FINISHPAGE_RUN "$INSTDIR\${EXE}"
!define MUI_FINISHPAGE_RUN_TEXT "Open ${NAME}"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

; Tells Explorer that file associations changed (SHCNE_ASSOCCHANGED).
!macro RefreshShell
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

Section "Install"
  SetOutPath "$INSTDIR"

  ; A running copy keeps its files locked. Report that plainly rather than
  ; leaving a half-updated install behind.
  SetOverwrite try
  ClearErrors
  File "${DIST}\${EXE}"
  File "${DIST}\pdfium.dll"
  IfErrors 0 files_ok
    MessageBox MB_OK|MB_ICONEXCLAMATION "${NAME} is running. Close it and run Setup again." /SD IDOK
    Abort "${NAME} is running."
  files_ok:
  SetOverwrite on

  File "${DIST}\LICENSE.pdfium"
  File "${DIST}\LICENSE.lucide"
  File "/oname=folio.ico" "${ICON}"
  WriteUninstaller "$INSTDIR\uninstall.exe"

  WriteRegStr HKCU "${SETTINGS_KEY}" "InstallDir" "$INSTDIR"

  CreateShortcut "$SMPROGRAMS\${NAME}.lnk" "$INSTDIR\${EXE}" "" "$INSTDIR\folio.ico" 0 "" "" "${DESCRIPTION}"

  ; Settings > Apps > Installed apps.
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayName" "${NAME}"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\folio.ico"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegStr HKCU "${UNINSTALL_KEY}" "QuietUninstallString" '"$INSTDIR\uninstall.exe" /S'
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoRepair" 1
  !ifdef PUBLISHER
    WriteRegStr HKCU "${UNINSTALL_KEY}" "Publisher" "${PUBLISHER}"
  !endif
  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  IntFmt $0 "0x%08X" $0
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "EstimatedSize" "$0"

  ; The document type, with Open and Print verbs.
  WriteRegStr HKCU "${CLASSES}\${PROGID}" "" "PDF Document"
  WriteRegStr HKCU "${CLASSES}\${PROGID}\DefaultIcon" "" "$INSTDIR\folio.ico"
  WriteRegStr HKCU "${CLASSES}\${PROGID}\shell\open\command" "" '"$INSTDIR\${EXE}" "%1"'
  WriteRegStr HKCU "${CLASSES}\${PROGID}\shell\print\command" "" '"$INSTDIR\${EXE}" "%1" --print'

  ; Offer it for .pdf without taking the association over.
  WriteRegStr HKCU "${CLASSES}\.pdf\OpenWithProgids" "${PROGID}" ""
  WriteRegStr HKCU "${CLASSES}\Applications\${EXE}" "FriendlyAppName" "${NAME}"
  WriteRegStr HKCU "${CLASSES}\Applications\${EXE}\DefaultIcon" "" "$INSTDIR\folio.ico"
  WriteRegStr HKCU "${CLASSES}\Applications\${EXE}\SupportedTypes" ".pdf" ""
  WriteRegStr HKCU "${CLASSES}\Applications\${EXE}\shell\open\command" "" '"$INSTDIR\${EXE}" "%1"'

  ; Lets Settings > Default apps list Folio as a choice for PDF.
  WriteRegStr HKCU "${SETTINGS_KEY}\Capabilities" "ApplicationName" "${NAME}"
  WriteRegStr HKCU "${SETTINGS_KEY}\Capabilities" "ApplicationDescription" "${DESCRIPTION}"
  WriteRegStr HKCU "${SETTINGS_KEY}\Capabilities\FileAssociations" ".pdf" "${PROGID}"
  WriteRegStr HKCU "Software\RegisteredApplications" "${NAME}" "${SETTINGS_KEY}\Capabilities"

  !insertmacro RefreshShell
SectionEnd

Section "Uninstall"
  ClearErrors
  Delete "$INSTDIR\${EXE}"
  IfErrors 0 not_running
    MessageBox MB_OK|MB_ICONEXCLAMATION "${NAME} is running. Close it and try again." /SD IDOK
    Abort "${NAME} is running."
  not_running:

  Delete "$INSTDIR\pdfium.dll"
  Delete "$INSTDIR\LICENSE.pdfium"
  Delete "$INSTDIR\LICENSE.lucide"
  Delete "$INSTDIR\folio.ico"
  Delete "$INSTDIR\uninstall.exe"
  ; Only the files above are removed, and the directory only if that leaves
  ; it empty: it may be a folder the user chose that holds other things.
  RMDir "$INSTDIR"

  Delete "$SMPROGRAMS\${NAME}.lnk"

  DeleteRegKey HKCU "${UNINSTALL_KEY}"
  DeleteRegKey HKCU "${CLASSES}\${PROGID}"
  DeleteRegKey HKCU "${CLASSES}\Applications\${EXE}"
  DeleteRegValue HKCU "${CLASSES}\.pdf\OpenWithProgids" "${PROGID}"
  ; Other programs register here too; these go only if nothing else is left.
  DeleteRegKey /ifempty HKCU "${CLASSES}\.pdf\OpenWithProgids"
  DeleteRegKey /ifempty HKCU "${CLASSES}\.pdf"
  DeleteRegValue HKCU "Software\RegisteredApplications" "${NAME}"
  DeleteRegKey HKCU "${SETTINGS_KEY}"

  !insertmacro RefreshShell
SectionEnd
